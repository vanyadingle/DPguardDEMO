# ==============================================================================
# DP-Guard Environment Configuration
# ==============================================================================

# LLM Provider selection: "gemini", "openai", "mock" (leave empty to auto-detect from keys)
LLM_PROVIDER=gemini

# 1. Google Gemini API (Free at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Privacy budget for the orchestration window
DP_EPSILON_TOTAL=2.0

# Safety thresholds for Admissibility Verifier
THREAT_SAFETY_THRESHOLD=30.0
ANOMALY_SAFETY_THRESHOLD=40.0
VERIFICATION_BETA=0.05

# Orchestrator role for typed policy (security_operator, network_admin, readonly_auditor)
DP_GUARD_ROLE=security_operator

