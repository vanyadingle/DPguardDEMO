# OpenAI API key for real LLM orchestration (optional - falls back to mock without it)
OPENAI_API_KEY=sk-your-key-here

# Model name (gpt-4o-mini is cost-effective for demos)
OPENAI_MODEL=gpt-4o-mini

# Privacy budget for the demo window
DP_EPSILON_TOTAL=2.0

# Safety thresholds
THREAT_SAFETY_THRESHOLD=30.0
ANOMALY_SAFETY_THRESHOLD=40.0
VERIFICATION_BETA=0.05

# Orchestrator role for typed policy
DP_GUARD_ROLE=security_operator
